## NanoPi R4S driver extensions
## RK3399: native GbE + PCIe GbE, USB 3.0/2.0, microSD/eMMC, 4-pin fan, debug UART.
## The PCIe NIC driver (kmod-r8168) and gpio-button-hotplug are provided by the
## upstream friendlyarm_nanopi-r4s device profile. Verify r8168 in dmesg before
## adding any USB NIC drivers.

## File System Drivers
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-squashfs=y
CONFIG_PACKAGE_kmod-fs-vfat=y

## I2C / fan
## The RK3399 PWM provider comes from the rockchip target kernel/DTS; only the
## pwm-fan hwmon driver is added here.
CONFIG_PACKAGE_kmod-i2c-core=y
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y

## USB Storage
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

## Optional: USB 2.5GbE adapters (RTL8152/RTL8153)
# CONFIG_PACKAGE_kmod-usb-net-rtl8152=y

## Optional: NTFS via user-space ntfs-3g, or enable the in-kernel driver
# CONFIG_PACKAGE_ntfs-3g=y
# CONFIG_PACKAGE_kmod-fs-ntfs3=y
