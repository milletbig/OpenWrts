{
  "workflow": {
    "manual": {
      "default_repo": "lede",
      "default_device": "rockchip",
      "default_flavor": "standard"
    },
    "schedule": {
      "default_repo": "lede",
      "default_devices": "rockchip",
      "default_flavors": "standard"
    }
  },
  "builds": {
    "lede": {
      "branch": "master",
      "url": "https://github.com/coolsnowwolf/lede",
      "devices": [
        {
          "id": "rockchip",
          "op_name": "NanoPi-R4S",
          "flavor": "standard",
          "target_config": "configs/targets/rockchip.config",
          "app_config": "configs/apps/lede/standard.config",
          "driver_config": "configs/drivers/lede/rockchip.config",
          "cache_scope": "lede-rockchip-standard"
        },
        {
          "id": "rockchip",
          "op_name": "NanoPi-R4S",
          "flavor": "lite",
          "target_config": "configs/targets/rockchip.config",
          "app_config": "configs/apps/common/lite.config",
          "cache_scope": "lede-rockchip-lite",
          "driver_config": "configs/drivers/lede/rockchip.config"
        }
      ]
    },
    "immortalwrt": {
      "branch": "master",
      "url": "https://github.com/immortalwrt/immortalwrt",
      "devices": [
        {
          "id": "rockchip",
          "op_name": "NanoPi-R4S",
          "flavor": "lite",
          "target_config": "configs/targets/rockchip.config",
          "app_config": "configs/apps/common/lite.config",
          "driver_config": "configs/drivers/immortalwrt/common.config",
          "cache_scope": "immortalwrt-rockchip-lite"
        }
      ]
    }
  }
}
